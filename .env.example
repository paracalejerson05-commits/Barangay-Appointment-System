# Set these in the Vercel project environment settings, never commit real values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-server-side-supabase-secret-key

# Optional server-side integrations. Never use a VITE_ prefix for this key.
GEMINI_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
